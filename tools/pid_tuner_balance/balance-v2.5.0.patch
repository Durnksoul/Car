@@ -0,0 +1,135 @@
+import math
+import unittest
+from unittest.mock import patch
+from core.balance_recovery import (BalanceRecoveryEnv, RecoveryNotVerified,
+                                   calculate_recovery_metrics, static_failure_reasons)
+from core.buffer import AdvancedDataBuffer
+from core.config import CONFIG
+from core.tuning_engine import run_tuning_engine
+from pid_safety import is_good_enough, maybe_update_best_result
+from tests.test_balance_car_patch import PID, Env, Tuner, samples
+
+
+def recovery_rows(kind='decay'):
+    rows=[]
+    for n in range(201):
+        t=n*.05
+        angle=(2.*math.exp(-t)*math.cos(t*3.) if kind=='decay' else
+               2.*math.cos(t*3.) if kind=='rocking' else
+               .1 if kind=='quiet' else 2.*math.exp(-t/12.)*math.cos(t*3.))
+        rows.append(dict(timestamp=n*50,input=angle,setpoint=0.,pwm=4.*angle,error=-angle,**PID))
+    return rows
+
+class Bridge:
+    def __init__(self,rows): self.rows=iter(rows)
+    def read_line(self): return next(self.rows,None)
+    def parse_data(self,line): return line
+
+class RecoveryTests(unittest.TestCase):
+    def test_motionless_offset_explains_angle_error_instead_of_rocking(self):
+        from core.balance_metrics import calculate_balance_metrics
+        rows=samples(.0)
+        for row in rows: row['input']=.7
+        m=calculate_balance_metrics(rows)
+        with patch.dict(CONFIG,GOOD_ENOUGH_AVG_ERROR=.8,GOOD_ENOUGH_STEADY_STATE_ERROR=.6):
+            reasons=static_failure_reasons(m)
+        self.assertEqual(len(reasons),1)
+        self.assertIn('末段角度误差',reasons[0])
+        self.assertEqual(m['peak_to_peak_deg'],0.)
+    def test_ready_static_data_has_no_failure_reason(self):
+        from core.balance_metrics import calculate_balance_metrics
+        with patch.dict(CONFIG,GOOD_ENOUGH_AVG_ERROR=.8,GOOD_ENOUGH_STEADY_STATE_ERROR=.6):
+            self.assertEqual(static_failure_reasons(calculate_balance_metrics(samples(.1))),[])
+    def test_decaying_response_passes_and_records_settling(self):
+        m=calculate_recovery_metrics(recovery_rows(),0.)
+        self.assertTrue(m['recovery_passed'])
+        self.assertLess(m['settling_time_s'],5.)
+        self.assertLess(m['decay_ratio'],.5)
+    def test_persistent_and_slow_oscillation_fail(self):
+        for kind in ('rocking','slow'):
+            m=calculate_recovery_metrics(recovery_rows(kind),0.)
+            self.assertFalse(m['recovery_passed'])
+    def test_quiet_data_cannot_prove_recovery(self):
+        m=calculate_recovery_metrics(recovery_rows('quiet'),0.)
+        self.assertFalse(m['recovery_passed'])
+        self.assertFalse(is_good_enough(m))
+    def test_short_trial_cannot_pass(self):
+        with self.assertRaises(RecoveryNotVerified):
+            calculate_recovery_metrics(recovery_rows()[:100],0.)
+    def test_unverified_static_trial_cannot_be_best(self):
+        metrics=dict(recovery_required=True,recovery_tested=False,metric_profile='balance_car_v1')
+        self.assertIsNone(maybe_update_best_result(None,PID,metrics,1))
+    def test_static_only_engine_never_converges(self):
+        env=Env([.1,.1,.1])
+        env.recovery_metrics=dict(recovery_required=True,recovery_tested=False,recovery_passed=False)
+        with patch.dict(CONFIG,BALANCE_ACTIVE=True,BALANCE_REQUIRE_RECOVERY=True,
+                        BUFFER_SIZE=100,MAX_TUNING_ROUNDS=3,REQUIRED_STABLE_ROUNDS=3):
+            result=run_tuning_engine(env,Tuner(),'generic',emit_console=False)
+        self.assertFalse(result['converged'])
+        self.assertFalse(result['recovery_verified'])
+    def test_three_recovery_passes_converge(self):
+        class RecoveryEnv(Env):
+            def collect_samples(self):
+                rows=recovery_rows()
+                self.recovery_metrics=calculate_recovery_metrics(rows,0.)
+                return rows
+        env=RecoveryEnv([]); tuner=Tuner()
+        with patch.dict(CONFIG,BALANCE_ACTIVE=True,BALANCE_REQUIRE_RECOVERY=True,
+                        BUFFER_SIZE=100,MAX_TUNING_ROUNDS=3,REQUIRED_STABLE_ROUNDS=3):
+            result=run_tuning_engine(env,tuner,'generic',emit_console=False)
+        self.assertTrue(result['converged'])
+        self.assertTrue(result['recovery_verified'])
+        self.assertEqual(tuner.calls,0)
+    def test_environment_waits_then_observes_full_trial(self):
+        rows=recovery_rows()
+        # The trigger requires three consecutive displaced samples.
+        for n in range(3): rows[n]['input']=2.; rows[n]['pwm']=8.
+        for row in rows: row['timestamp']+=5000
+        phases=[]
+        env=BalanceRecoveryEnv(Bridge(rows),PID,phase_callback=lambda p,m:phases.append(p))
+        with patch('core.adapters.HardwareEnv.collect_samples',return_value=samples(.1)), \
+             patch('core.balance_recovery.require_armed'):
+            result=env.collect_samples()
+        self.assertGreaterEqual(result[-1]['timestamp']-result[0]['timestamp'],10000)
+        self.assertIn('waiting_push',phases)
+        self.assertIn('recovering',phases)
+        self.assertTrue(env.recovery_metrics['recovery_tested'])
+    def test_timeout_is_unverified_without_ai_or_gain_change(self):
+        env=BalanceRecoveryEnv(Bridge([]),PID)
+        with patch('core.adapters.HardwareEnv.collect_samples',return_value=samples(.1)), \
+             patch('core.balance_recovery.WAIT_SECONDS',0.):
+            with self.assertRaises(RecoveryNotVerified): env.collect_samples()
+        self.assertFalse(env.recovery_metrics['recovery_tested'])
+    def test_effective_inner_target_can_change_after_push(self):
+        row=recovery_rows()[0]; row['setpoint']=.12
+        env=BalanceRecoveryEnv(Bridge([row]),PID)
+        env.expected_pid=PID; env.expected_setpoint=0.
+        import time
+        actual=env._read_sample(time.monotonic()+.1)
+        self.assertEqual(actual['setpoint'],.12)
+    def test_tracking_a_moving_target_cannot_hide_physical_rocking(self):
+        rows=recovery_rows('rocking')
+        for row in rows: row['setpoint']=row['input']
+        m=calculate_recovery_metrics(rows,0.)
+        self.assertFalse(m['recovery_passed'])
+        self.assertGreater(m['late_peak_error_deg'],1.)
+        self.assertEqual(m['nominal_setpoint_deg'],0.)
+    def test_variable_inner_target_does_not_fail_good_recovery(self):
+        rows=recovery_rows()
+        for n,row in enumerate(rows): row['setpoint']=.2*math.sin(n*.1)
+        m=calculate_recovery_metrics(rows,0.)
+        self.assertTrue(m['recovery_passed'])
+        self.assertLess(m['effective_setpoint_min_deg'],0.)
+        self.assertGreater(m['effective_setpoint_max_deg'],0.)
+    def test_explicit_setpoint_command_still_interrupts_verification(self):
+        env=BalanceRecoveryEnv(Bridge(['# Setpoint Updated: 1.000 deg from upright']),PID)
+        env.expected_pid=PID
+        import time
+        with self.assertRaises(RecoveryNotVerified): env._read_sample(time.monotonic()+.1)
+    def test_gain_changes_during_wait_reject_trial(self):
+        row=recovery_rows()[0]; row['p']=4.2
+        env=BalanceRecoveryEnv(Bridge([row]),PID)
+        with patch('core.adapters.HardwareEnv.collect_samples',return_value=samples(.1)):
+            with self.assertRaises(RecoveryNotVerified): env.collect_samples()
+
+if __name__=='__main__': unittest.main()
