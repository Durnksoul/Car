+import json
+from pathlib import Path
+import tempfile
+from PySide6.QtWidgets import QApplication
+from PySide6.QtCore import QTimer
+import runpy
+app=QApplication([])
+checks=[]
+def check():
+    windows=[w for w in app.topLevelWidgets() if hasattr(w,'balance_instruction')]
+    assert len(windows)==1
+    w=windows[0]
+    assert '抗扰测试' in w.windowTitle()
+    assert w.mode.currentData()=='hardware'
+    w._event(dict(type='balance_phase',phase='waiting_push',message='请轻推一下后松手'))
+    assert '轻推' in w.balance_instruction.text()
+    with tempfile.TemporaryDirectory() as directory:
+        output=Path(directory)/'report.json'
+        w.archive.export_json(str(output))
+        report=json.loads(output.read_text(encoding='utf-8'))
+        assert report['balance_phases'][0]['phase']=='waiting_push'
+    checks.append(True)
+    w.close()
+    app.quit()
+QTimer.singleShot(800,check)
+runpy.run_path(str(Path(__file__).resolve().parents[1]/'balance_main.py'),run_name='__main__')
+assert checks
+print('RECOVERY_UI_AND_REPORT_OK')
