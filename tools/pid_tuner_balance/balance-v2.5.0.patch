@@ -0,0 +1,82 @@
+import math
+import unittest
+from unittest.mock import patch
+from core.buffer import AdvancedDataBuffer
+from core.config import CONFIG
+from core.balance_metrics import calculate_balance_metrics, require_armed
+from core.tuning_session import create_tuning_session, evaluate_completed_round, finalize_decision
+from core.tuning_engine import run_tuning_engine
+from pid_safety import score_metrics
+
+PID = dict(p=4.,i=.1,d=0.)
+def samples(amplitude=3., target=0., pid=None):
+    return [dict(timestamp=n*50,setpoint=target,input=target+amplitude*math.sin(n*.05*2*math.pi*.8),
+                 pwm=amplitude*4*math.sin(n*.05*2*math.pi*.8),error=0.,**(pid or PID)) for n in range(100)]
+
+class Env:
+    def __init__(self, amplitudes):
+        self.amplitudes=iter(amplitudes); self.pid=dict(PID); self.applied=[]
+    def get_current_pid(self): return dict(self.pid),None
+    def get_setpoint(self): return 0.
+    def get_prompt_context(self): return {}
+    def reset_buffer_state(self): pass
+    def collect_samples(self): return samples(next(self.amplitudes),pid=self.pid)
+    def apply_pid(self,pid,secondary=None): self.pid=dict(pid); self.applied.append(dict(pid))
+class Tuner:
+    def __init__(self): self.calls=0
+    def analyze(self,*args,**kwargs):
+        self.calls+=1
+        return dict(p=4.+.1*self.calls,i=.1,d=.01*self.calls,status='DONE')
+class BalanceTests(unittest.TestCase):
+    def setUp(self):
+        self.config=patch.dict(CONFIG,BALANCE_ACTIVE=True,MAX_TUNING_ROUNDS=3,BUFFER_SIZE=100,
+            REQUIRED_STABLE_ROUNDS=3,GOOD_ENOUGH_AVG_ERROR=.8,GOOD_ENOUGH_STEADY_STATE_ERROR=.6)
+        self.config.start(); self.addCleanup(self.config.stop)
+    def test_zero_and_negative_targets_do_not_create_percent_overshoot(self):
+        results=[calculate_balance_metrics(samples(target=t)) for t in (0.,.00001,-.2)]
+        for result in results:
+            self.assertEqual(result['status'],'OSCILLATING')
+            self.assertEqual(result['overshoot'],0.)
+        self.assertAlmostEqual(score_metrics(results[0]),score_metrics(results[-1]))
+    def test_slow_rocking_is_not_stable(self):
+        m=calculate_balance_metrics(samples())
+        self.assertLess(m['zero_crossings'],30)
+        self.assertEqual(m['status'],'OSCILLATING')
+    def test_zero_error_has_zero_score(self):
+        self.assertEqual(score_metrics(dict(avg_error=0.,steady_state_error=0.,overshoot=0.,status='STABLE')),0.)
+    def test_nonfinite_timestamps_and_mixed_pid_rejected(self):
+        for key,value in [('input',float('nan')),('timestamp',0.),('p',4.1)]:
+            rows=samples(); rows[20][key]=value
+            with self.assertRaises(ValueError): calculate_balance_metrics(rows)
+    def test_done_cannot_bypass_acceptance(self):
+        state=create_tuning_session(initial_pid=PID)
+        for row in samples(): state.buffer.add(row)
+        evaluation=evaluate_completed_round(state,PID)
+        result=finalize_decision(state,evaluation,dict(**PID,status='DONE'))
+        self.assertEqual(result.status,'TUNING')
+        self.assertIsNone(result.completed_reason)
+    def test_engine_continues_done_and_restores_measured_best(self):
+        env=Env([3.,2.,2.1]); tuner=Tuner()
+        result=run_tuning_engine(env,tuner,'generic',emit_console=False)
+        self.assertEqual(tuner.calls,2)
+        self.assertEqual(result['completed_reason'],'max_rounds_reached')
+        self.assertFalse(result['converged'])
+        self.assertEqual(result['final_metrics']['measured_round'],2)
+        self.assertAlmostEqual(result['final_pid']['p'],4.1)
+    def test_three_measured_passes_and_no_model_calls(self):
+        env=Env([.1,.1,.1]); tuner=Tuner()
+        result=run_tuning_engine(env,tuner,'generic',emit_console=False)
+        self.assertEqual(result['completed_reason'],'stable_rounds_reached')
+        self.assertEqual(tuner.calls,0)
+        self.assertTrue(result['converged'])
+    def test_missing_ai_response_does_not_apply_fallback(self):
+        state=create_tuning_session(initial_pid=PID)
+        for row in samples(): state.buffer.add(row)
+        with self.assertRaises(RuntimeError): finalize_decision(state,evaluate_completed_round(state,PID),None)
+    def test_unarmed_car_cannot_be_scored(self):
+        class Bridge:
+            def send_profile_command(self,cmd): return True
+            def read_line(self): return '# STATUS: Armed=0 State=5'
+        with self.assertRaises(RuntimeError): require_armed(Bridge())
+
+if __name__=='__main__': unittest.main()
