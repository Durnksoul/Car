+from desktop.i18n import TEXT
+TEXT.update(window=("LLM PID Tuner - 平衡车修正版 · 抗扰测试", "LLM PID Tuner - Balance edition"),
+            overshoot=("最大角度误差", "PEAK ANGLE ERROR"),
+            col_overshoot=("最大误差 (deg)", "Peak error (deg)"),
+            overshoot_hint=("角度单位，不使用百分比超调", "Degrees; percentage overshoot is unused"),
+            subtitle=("姿态环调参：静止检查 → 提示轻推 → 观察恢复，连续三轮通过才结束。", "Attitude tuning: reduce rocking; require three measured passes."))
+from desktop.app import run_desktop
+run_desktop(language='zh')
