diff --git a/core/balance_metrics.py b/core/balance_metrics.py
new file mode 100644
--- /dev/null
+++ b/core/balance_metrics.py
@@ -0,0 +1,95 @@
+"""Angle-domain metrics for the car's millisecond CSV stream.
+
+Rate is a finite-difference estimate, not the IMU gyro measurement.
+The legacy overshoot field is zero/unused; all acceptance limits have units.
+"""
+import math
+
+LIMITS = dict(rms_error_deg=0.8, peak_error_deg=2.0,
+              peak_to_peak_deg=2.0, estimated_rate_rms_dps=6.0,
+              duration_s=4.0)
+
+def calculate_balance_metrics(data, reference_setpoint=None):
+    if len(data) < 2:
+        raise ValueError("Balance tuning needs at least two samples")
+    times = [float(d['timestamp']) / 1000 for d in data]
+    inputs = [float(d['input']) for d in data]
+    setpoints = [float(d['setpoint']) for d in data]
+    errors = [(sp if reference_setpoint is None else reference_setpoint)-pv
+              for sp,pv in zip(setpoints, inputs)]
+    pwms = [float(d['pwm']) for d in data]
+    if not all(math.isfinite(v) for v in times + inputs + setpoints + errors + pwms):
+        raise ValueError("Non-finite balance telemetry")
+    intervals = [b-a for a,b in zip(times,times[1:])]
+    if any(dt <= 0 or dt > 0.25 for dt in intervals):
+        raise ValueError("Balance telemetry timestamp reset/gap; restart the run")
+    # Mixed gains cannot be used to score a single PID trial.
+    for gain in ('p', 'i', 'd'):
+        values = [float(d[gain]) for d in data]
+        if not all(math.isfinite(v) for v in values) or max(values)-min(values)>1e-6:
+            raise ValueError("PID changed inside a trial; restart the run")
+    rates = [(b-a)/dt for a,b,dt in zip(inputs,inputs[1:],intervals)]
+    rms = lambda values: math.sqrt(sum(v*v for v in values)/len(values))
+    absolute = [abs(e) for e in errors]
+    tail = max(1,len(data)//5)
+    crossings = 0
+    sign = 0
+    for e in errors:
+        next_sign = 1 if e > 0.2 else -1 if e < -0.2 else 0
+        if next_sign:
+            if sign and next_sign != sign:
+                crossings += 1
+            sign = next_sign
+    metrics = dict(metric_profile='balance_car_v1',
+        avg_error=sum(absolute)/len(data), max_error=max(absolute),
+        steady_state_error=sum(absolute[-tail:])/tail, overshoot=0.0,
+        overshoot_applicable=False, zero_crossings=crossings,
+        rms_error_deg=rms(errors), peak_error_deg=max(absolute),
+        peak_to_peak_deg=max(errors)-min(errors),
+        estimated_rate_rms_dps=rms(rates), duration_s=times[-1]-times[0],
+        pwm_step_rms_pct=rms([b-a for a,b in zip(pwms,pwms[1:])]),
+        setpoint=float(data[-1]['setpoint']) if reference_setpoint is None else reference_setpoint)
+    if reference_setpoint is not None:
+        metrics.update(nominal_setpoint_deg=reference_setpoint,
+                       effective_setpoint_min_deg=min(setpoints),
+                       effective_setpoint_max_deg=max(setpoints),
+                       effective_setpoint_source='inner_target_including_speed_feedback')
+    passed = all(metrics[k] <= v for k,v in LIMITS.items() if k != 'duration_s')
+    if metrics['duration_s'] < LIMITS['duration_s']:
+        metrics['status'] = 'INSUFFICIENT_DATA'
+    elif passed:
+        metrics['status'] = 'STABLE'
+    elif crossings >= 2 or metrics['estimated_rate_rms_dps'] > LIMITS['estimated_rate_rms_dps']:
+        metrics['status'] = 'OSCILLATING'
+    else:
+        metrics['status'] = 'SLOW_RESPONSE'
+    return metrics
+
+def balance_score(metrics):
+    # Continuous objective allows comparing two still-oscillatory trials.
+    recovery_cost = 0.
+    if metrics.get('recovery_tested'):
+        settling = metrics.get('settling_time_s')
+        recovery_cost = (0.2*(10. if settling is None else settling)
+                         + 2.*min(metrics['decay_ratio'],5.)
+                         + 0.1*metrics['recovery_peak_error_deg'])
+    return (recovery_cost + metrics['rms_error_deg'] + 0.35*metrics['peak_to_peak_deg']
+            + 0.1*metrics['estimated_rate_rms_dps']
+            + 0.01*metrics['pwm_step_rms_pct'])
+
+
+def require_armed(bridge):
+    """Avoid scoring an unpowered or fallen car as excellent control."""
+    import time
+    if not bridge.send_profile_command('STATUS'):
+        raise RuntimeError('Cannot query car STATUS')
+    deadline = time.monotonic() + 2.0
+    while time.monotonic() < deadline:
+        line = bridge.read_line()
+        if not line or '# STATUS:' not in str(line):
+            continue
+        fields = dict(item.split('=',1) for item in str(line).split() if '=' in item)
+        if fields.get('Armed') != '1' or fields.get('State') != '1':
+            raise RuntimeError('Car is not balancing (Armed=1 State=1 required); no PID applied')
+        return
+    raise RuntimeError('Car STATUS response missing; no trial can be scored')
diff --git a/core/balance_recovery.py b/core/balance_recovery.py
new file mode 100644
--- /dev/null
+++ b/core/balance_recovery.py
@@ -0,0 +1,170 @@
+"""Manual push-and-release trials; never inject motor commands or setpoints."""
+import math
+import time
+from core.adapters import HardwareEnv
+from core.balance_metrics import LIMITS, calculate_balance_metrics, require_armed
+from core.config import CONFIG
+from core.env import controller_requests_abort
+
+TRIGGER_DEG = 1.5
+TRIGGER_POINTS = 3
+MAX_INITIAL_DEG = 6.0
+WAIT_SECONDS = 45.0
+OBSERVE_SECONDS = 10.0
+SETTLE_ERROR_DEG = 0.8
+SETTLE_RATE_DPS = 6.0
+SETTLE_HOLD_SECONDS = 2.0
+MAX_SETTLE_SECONDS = 5.0
+MAX_DECAY_RATIO = 0.5
+
+class RecoveryNotVerified(RuntimeError):
+    pass
+
+def calculate_recovery_metrics(rows, baseline_input):
+    # Validate the entire trial, including the disturbance, before scoring its tail.
+    calculate_balance_metrics(rows, reference_setpoint=0.0)
+    start = rows[0]['timestamp']
+    times = [(row['timestamp']-start)/1000 for row in rows]
+    if times[-1] < OBSERVE_SECONDS:
+        raise RecoveryNotVerified('抗扰采样不足 10 秒，本次未验证')
+    errors = [abs(row['input']) for row in rows]  # physical upright error, not moving inner target
+    rates = [0.] + [abs((b['input']-a['input'])/((b['timestamp']-a['timestamp'])/1000))
+                    for a,b in zip(rows,rows[1:])]
+    # The stable suffix must extend to the end, not merely touch the target once.
+    suffix = len(rows)
+    for i in range(len(rows)-1,-1,-1):
+        if errors[i] > SETTLE_ERROR_DEG or rates[i] > SETTLE_RATE_DPS:
+            break
+        suffix = i
+    settling = None
+    if suffix < len(rows) and times[-1]-times[suffix] >= SETTLE_HOLD_SECONDS:
+        settling = times[suffix]
+    early = max(e for e,t in zip(errors,times) if t <= 2.)
+    late = max(e for e,t in zip(errors,times) if t >= OBSERVE_SECONDS-4.)
+    decay = late / max(early,0.01)
+    excursion = max(abs(row['input']-baseline_input) for row in rows)
+    tail = [row for row,t in zip(rows,times) if t >= OBSERVE_SECONDS-4.]
+    tail_metrics = calculate_balance_metrics(tail, reference_setpoint=0.0)
+    # Tail endpoints can differ by <4 s at a 20 Hz sample grid; duration is
+    # validated by the full trial, not by the rounded final-four-second slice.
+    tail_ok = (tail_metrics['rms_error_deg'] <= .8 and tail_metrics['peak_error_deg'] <= 2.
+               and tail_metrics['peak_to_peak_deg'] <= 2.
+               and tail_metrics['estimated_rate_rms_dps'] <= 6.)
+    passed = (excursion >= TRIGGER_DEG and settling is not None
+              and settling <= MAX_SETTLE_SECONDS and decay <= MAX_DECAY_RATIO and tail_ok
+              and tail_metrics['avg_error'] <= CONFIG['GOOD_ENOUGH_AVG_ERROR']
+              and tail_metrics['steady_state_error'] <= CONFIG['GOOD_ENOUGH_STEADY_STATE_ERROR'])
+    return {**tail_metrics, 'duration_s': times[-1], 'recovery_required': True,
+            'recovery_tested': True, 'recovery_passed': passed,
+            'recovery_peak_error_deg': max(errors), 'settling_time_s': settling,
+            'decay_ratio': decay, 'late_peak_error_deg': late,
+            'disturbance_excursion_deg': excursion,
+            'disturbance_source': 'manual_push_unmeasured_force',
+            'effective_setpoint_min_deg': min(row['setpoint'] for row in rows),
+            'effective_setpoint_max_deg': max(row['setpoint'] for row in rows),
+            'status': 'STABLE' if passed else 'OSCILLATING'}
+
+def static_failure_reasons(metrics):
+    checks = [
+        ('rms_error_deg', LIMITS['rms_error_deg'], '角度 RMS', '度'),
+        ('peak_error_deg', LIMITS['peak_error_deg'], '最大角度误差', '度'),
+        ('peak_to_peak_deg', LIMITS['peak_to_peak_deg'], '摆幅', '度'),
+        ('estimated_rate_rms_dps', LIMITS['estimated_rate_rms_dps'], '估计角速度 RMS', '度/秒'),
+        ('avg_error', CONFIG['GOOD_ENOUGH_AVG_ERROR'], '平均角度误差', '度'),
+        ('steady_state_error', CONFIG['GOOD_ENOUGH_STEADY_STATE_ERROR'], '末段角度误差', '度'),
+    ]
+    reasons = [f'{label} {metrics[key]:.3f}{unit} > {limit:.3f}{unit}'
+               for key,limit,label,unit in checks if metrics[key] > limit]
+    if metrics['duration_s'] < LIMITS['duration_s']:
+        reasons.append(f"采样时长 {metrics['duration_s']:.2f}秒 < {LIMITS['duration_s']:.2f}秒")
+    if metrics['status'] != 'STABLE' and not reasons:
+        reasons.append(f"采样状态 {metrics['status']}")
+    return reasons
+
+class BalanceRecoveryEnv(HardwareEnv):
+    def __init__(self, *args, phase_callback=None, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.phase_callback = phase_callback or (lambda phase,message: None)
+        self.recovery_metrics = {}
+        self.expected_pid = None
+        self.expected_setpoint = None
+
+    def _phase(self, phase, message):
+        self.phase_callback(phase,message)
+
+    def _read_sample(self, deadline):
+        while time.monotonic() < deadline:
+            if controller_requests_abort(self.controller):
+                raise RecoveryNotVerified('已停止，抗扰能力未验证')
+            line = self.bridge.read_line()
+            if line and '# Setpoint Updated:' in str(line):
+                raise RecoveryNotVerified('检测到手动 SETPOINT 命令，请保持 SP=0 后重新开始测试')
+            row = self.bridge.parse_data(line) if line else None
+            if row is None:
+                continue
+            values = [float(row[k]) for k in ('timestamp','input','setpoint','pwm','p','i','d')]
+            if not all(math.isfinite(v) for v in values):
+                raise RecoveryNotVerified('采样数值无效，抗扰能力未验证')
+            if any(abs(row[k]-self.expected_pid[k])>1e-6 for k in ('p','i','d')):
+                raise RecoveryNotVerified('测试过程中 PID 改变，请重新开始')
+            self.current_pid = {k:row[k] for k in ('p','i','d')}
+            self.current_setpoint = row['setpoint']
+            self.notify_sample(row)
+            return row
+        return None
+
+    def collect_samples(self):
+        self.recovery_metrics = dict(recovery_required=True,recovery_tested=False,recovery_passed=False)
+        self._phase('static_check','静止检查：请松手，让车自行平衡；此时暂不轻推。')
+        static_rows = super().collect_samples()
+        if not static_rows:
+            return static_rows
+        m = calculate_balance_metrics(static_rows, reference_setpoint=0.0)
+        failed = static_failure_reasons(m)
+        if failed:
+            self._phase('static_not_ready','尚未进入轻推测试：' + '；'.join(failed)
+                        + '。角度误差超标也可能是静止时偏离零点，不代表车一定在运动；暂不轻推。')
+            return static_rows
+        self.expected_pid = {k: static_rows[-1][k] for k in ('p','i','d')}
+        self.expected_setpoint = static_rows[-1]['setpoint']
+        baseline = sum(row['input'] for row in static_rows[-20:])/len(static_rows[-20:])
+        self._phase('waiting_push','静止检查通过：请轻推车身一下后立即松手。等待有效扰动（最多 45 秒）。')
+        deadline = time.monotonic()+WAIT_SECONDS
+        trigger = []
+        previous = static_rows[-1]['timestamp']
+        while time.monotonic() < deadline:
+            row = self._read_sample(deadline)
+            if row is None:
+                break
+            if row['timestamp'] <= previous:
+                raise RecoveryNotVerified('设备时间戳重置，抗扰能力未验证')
+            previous = row['timestamp']
+            excursion = abs(row['input']-baseline)
+            if excursion > MAX_INITIAL_DEG:
+                raise RecoveryNotVerified('初始扰动过大，请重新扶正，使用更轻的单次推动')
+            trigger = trigger+[row] if excursion >= TRIGGER_DEG else []
+            if len(trigger) >= TRIGGER_POINTS:
+                break
+        if len(trigger) < TRIGGER_POINTS:
+            raise RecoveryNotVerified('未检测到有效轻推：静止检查通过，抗扰能力未验证；PID 未因静止达标而改变')
+        self._phase('recovering','检测到扰动：请完全松手，正在观察 10 秒恢复过程；不要再次推动。')
+        rows = list(trigger)
+        wall_deadline = time.monotonic()+OBSERVE_SECONDS+5.
+        while (rows[-1]['timestamp']-rows[0]['timestamp'])/1000 < OBSERVE_SECONDS:
+            row = self._read_sample(wall_deadline)
+            if row is None:
+                raise RecoveryNotVerified('恢复采样超时，抗扰能力未验证')
+            dt = (row['timestamp']-rows[-1]['timestamp'])/1000
+            if not 0 < dt <= .25:
+                raise RecoveryNotVerified('恢复采样中断或设备复位，抗扰能力未验证')
+            rows.append(row)
+        require_armed(self.bridge)
+        self.recovery_metrics = calculate_recovery_metrics(rows,baseline)
+        passed = self.recovery_metrics['recovery_passed']
+        settled = self.recovery_metrics['settling_time_s']
+        detail = ('未持续恢复' if settled is None else f'恢复用时 {settled:.2f} 秒')
+        detail += f"，末段峰值 {self.recovery_metrics['late_peak_error_deg']:.2f} 度。"
+        self._phase('recovery_pass' if passed else 'recovery_fail',
+                    detail + ('本轮抗扰通过；等待下一轮提示后再轻推。' if passed else
+                              '本轮抗扰未通过；正在分析并调整参数。'))
+        return rows
